#!/usr/bin/env bash

is_detached_head() {
    ! git symbolic-ref --quiet HEAD >/dev/null
}

create_github_release() {
    local -r version="$1"
    local -r release_tag="$2"

    local staging_dir
    staging_dir="$(mktemp -d)"
    sed "s/^readonly VERSION='dev'\$/readonly VERSION='$version'/" git-semver-release \
        > "$staging_dir/git-semver-release" || return 1

    gh release create "$release_tag" \
        --title "$version" \
        --notes-from-tag \
        "$staging_dir/git-semver-release" || return 1
}

run_tests() {
    bats test/test.bats || return 1
}

publish() {
    local -r version="$1"
    local -r latest="$2"
    local -r image='ghcr.io/michalstutzmann/git-semver-release'

    local -a tags=(--tag "$image:$version")
    if (( latest )); then
        tags+=(--tag "$image:latest")
    fi

    docker buildx build \
        --platform linux/amd64,linux/arm64 \
        --push \
        --sbom=false \
        --provenance=false \
        --build-arg "VERSION=$version" \
        "${tags[@]}" \
        . || return 1
}

main() {
    if ! command -v gh >/dev/null 2>&1; then
        printf 'error: gh is not installed or not on PATH\n' 1>&2
        return 1
    elif ! gh auth status >/dev/null 2>&1; then
        printf 'error: gh is not authenticated (run: gh auth login)\n' 1>&2
        return 2
    fi

    if ! command -v docker >/dev/null 2>&1; then
        printf 'error: docker is not installed or not on PATH\n' 1>&2
        return 3
    elif ! docker buildx inspect >/dev/null 2>&1; then
        printf 'error: docker buildx is not configured (run: docker buildx create --use)\n' 1>&2
        return 4
    fi

    if ! command -v bats >/dev/null 2>&1; then
        printf 'error: bats is not installed or not on PATH\n' 1>&2
        return 5
    fi

    local version
    version="$(./git-semver-release version)" || return 6

    local release_tag
    release_tag="$(./git-semver-release release-tag)" || return 7

    printf 'Testing\n' 1>&2
    run_tests || return 8
    printf 'Tested\n' 1>&2

    if [[ -n $release_tag ]]; then
        if is_detached_head; then
            printf 'Publishing %s to GitHub Packages\n' "$version" 1>&2
            publish "$version" 1 || return 9
            printf 'Published %s to GitHub Packages\n' "$version" 1>&2

            if gh release view "$release_tag" >/dev/null 2>&1; then
                printf 'GitHub release %s already exists, skipping\n' "$release_tag" 1>&2
            else
                printf 'Creating GitHub release %s\n' "$release_tag" 1>&2
                create_github_release "$version" "$release_tag" || return 10
                printf 'Created GitHub release %s\n' "$release_tag" 1>&2
            fi
        else
            printf 'Branch build of tagged commit %s, leaving publishing to the tag build\n' "$release_tag" 1>&2
        fi
    else
        printf 'Publishing %s to GitHub Packages\n' "$version" 1>&2
        publish "$version" 0 || return 11
        printf 'Published %s to GitHub Packages\n' "$version" 1>&2
    fi
}

main "$@"
